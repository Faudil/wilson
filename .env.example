# Copy to .env. Generate keys with: openssl rand -base64 32
MASTER_KEY=CHANGE_ME_base64_32_bytes
LOOKUP_KEY=CHANGE_ME_base64_32_bytes

DATABASE_URL=postgres://wilson:wilson@postgres:5432/wilson
S3_ENDPOINT=http://s3:9000
S3_BUCKET=wilson
S3_ACCESS_KEY=wilson
S3_SECRET_KEY=wilson-secret-change-me

# sandbox = no Meta account needed; meta = real WhatsApp Cloud API (step by step: docs/whatsapp-setup.md)
WHATSAPP_MODE=sandbox
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Only used by `bun run --filter @wilson/api wa:setup` (templates, webhook subscription)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_GRAPH_VERSION=v23.0

# fake = canned analyses from samples/letters; anthropic = real model
LLM_MODE=fake
# Server key. Optional once admins add keys in the back-office (Plus > Coûts de l'IA > Clés API): those are used first.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Optional: faster model for the short calls a WhatsApp reply waits on (intent, translation). Empty = LLM_MODEL.
# LLM_FAST_MODEL=

ASSOCIATION_NAME=Association Wilson
ASSOCIATION_CONTACT=01 23 45 67 89 · 12 rue de l'Exemple, 75010 Paris · lun-ven 9h-17h

# First admin account, created by `bun run --filter @wilson/api seed`
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=change-me-please

# Volunteers can request an account from the login page; an admin approves it in "Bénévoles" (on|off)
VOLUNTEER_SIGNUP=on
VOLUNTEER_SIGNUP_MAX_PENDING=30
