{
  "name": "@wilson/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "seed": "bun src/db/seed.ts",
    "knowledge:sync": "bun src/knowledge/cli.ts",
    "wa:setup": "bun src/whatsapp/setupCli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@aws-sdk/client-s3": "3.1163.0",
    "@electric-sql/pglite": "0.5.15",
    "@orpc/contract": "1.16.2",
    "@orpc/server": "1.16.2",
    "@wilson/contracts": "workspace:*",
    "@wilson/i18n": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
