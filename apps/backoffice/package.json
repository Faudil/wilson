{
  "name": "@wilson/backoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot serve.ts",
    "build": "bun --bun tsc --noEmit && bun build.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "check:fonts": "bun scripts/check-glyphs.ts",
    "start": "bun serve.ts --production"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/noto-sans-armenian": "5.3.0",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@fontsource/noto-sans-ethiopic": "5.3.0",
    "@fontsource/noto-sans-georgian": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "@fontsource/vazirmatn": "5.3.0",
    "@orpc/client": "1.16.2",
    "@orpc/contract": "1.16.2",
    "@orpc/tanstack-query": "1.16.2",
    "@tanstack/react-query": "5.106.1",
    "@wilson/contracts": "workspace:*",
    "@wilson/i18n": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.9.3"
  }
}
