# Production configuration for docker-compose.prod.yml.
# Copy to the server as <DEPLOY_PATH>/.env, then `chmod 600 .env`. It never goes in git or in GitHub.
# Generate keys with: openssl rand -base64 32   ·   passwords with: openssl rand -hex 24
# Losing MASTER_KEY = losing every document and person record. Keep a copy offline (password manager).

# Encryption keys (32 bytes, base64)
MASTER_KEY=CHANGE_ME_base64_32_bytes
LOOKUP_KEY=CHANGE_ME_base64_32_bytes

# Public domain, served over HTTPS by nginx-proxy + acme-companion (Let's Encrypt).
# Point its DNS A/AAAA record at your proxy before the first deploy.
PUBLIC_HOST=courrier.example.org
LETSENCRYPT_EMAIL=CHANGE_ME@your-association.fr
# Docker network shared with nginx-proxy (external: created by your proxy stack)
PROXY_NETWORK=internal_services_network
# Only if the public address is not https://PUBLIC_HOST
# PUBLIC_ORIGIN=https://courrier.example.org

# Database (letters and digits only: it goes into a URL)
POSTGRES_PASSWORD=CHANGE_ME_hex

# Document storage: bundled SeaweedFS by default. For an EU provider, set S3_ENDPOINT/S3_REGION/S3_BUCKET.
S3_BUCKET=wilson
S3_ACCESS_KEY=wilson
S3_SECRET_KEY=CHANGE_ME_hex
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_REGION=fr-par

# Daily database backups into the backups volume
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
# Encrypted off-site copy (database + documents), see docs/security.md. Generate the key pair on YOUR computer
# with `age-keygen -o wilson-backup-key.txt`, keep that file offline, and paste only its public key ("age1...") here.
# BACKUP_AGE_RECIPIENT=age1...
# An EU bucket at another provider than the server (e.g. Scaleway fr-par, OVH gra), with a key that cannot delete.
# BACKUP_S3_BUCKET=wilson-backups
# BACKUP_S3_ENDPOINT=https://s3.fr-par.scw.cloud
# BACKUP_S3_REGION=fr-par
# BACKUP_S3_PROVIDER=Scaleway
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# Leave empty and use a lifecycle rule on the bucket instead (recommended)
# BACKUP_REMOTE_KEEP_DAYS=

# sandbox = no Meta account needed; meta = real WhatsApp Cloud API
WHATSAPP_MODE=sandbox
WHATSAPP_PHONE_NUMBER_ID=
# Only used by the wa:setup tool (templates, webhook subscription)
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# fake = canned analyses; anthropic = real model
LLM_MODE=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Optional: faster model for the short calls a WhatsApp reply waits on (intent, translation). Empty = LLM_MODEL.
# LLM_FAST_MODEL=

ASSOCIATION_NAME=Association Wilson
ASSOCIATION_CONTACT=01 23 45 67 89 · 12 rue de l'Exemple, 75010 Paris · lun-ven 9h-17h

# "Near me": OpenStreetMap asks for a contact; Soliguide needs a token (free for associations, ask Solinum)
OSM_CONTACT_EMAIL=CHANGE_ME@your-association.fr
# SOLIGUIDE_API_KEY=

# First admin account, created on first start (change the password after logging in)
SEED_ADMIN_EMAIL=CHANGE_ME@your-association.fr
SEED_ADMIN_PASSWORD=CHANGE_ME_long_password

# Flood guard for WhatsApp (per number, then all numbers together). Defaults shown.
# Above WA_RATE_*: messages are stored but not processed, the person is asked to slow down.
# Above WA_FLOOD_*: the number is held until a volunteer releases or blocks it (Plus > Numéros en attente).
# Above WA_GLOBAL_*: first messages from numbers seen in the last 24 h are held; known people are still served.
# WA_RATE_PER_MINUTE=8
# WA_RATE_PER_HOUR=60
# WA_FILES_PER_DAY=20
# WA_FLOOD_PER_MINUTE=20
# WA_FLOOD_PER_HOUR=150
# WA_FLOOD_PER_DAY=400
# WA_GLOBAL_PER_MINUTE=120
# WA_GLOBAL_PER_HOUR=1500

# Security alerts (floods, held numbers, unusual reads of personal data, login attacks) posted to a chat webhook
# (Mattermost, Slack, Discord, ntfy…). Alerts never contain names, phone numbers or message content.
# ALERT_WEBHOOK_URL=

# Account protection
# Admin rights (volunteers, audit, costs, knowledge sync, moderation) need an authenticator app (required|optional)
ADMIN_2FA=required
# LOGIN_MAX_FAILURES=5          # failed logins before an e-mail is locked (15 min, then doubling)
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_LOCK_MINUTES=15
# SIGNUP_PER_IP_PER_HOUR=3
# SIGNUP_PER_DAY=20
# Reverse proxies in front of the back-office: 1 = your nginx/Caddy/Traefik, 2 = Cloudflare + your proxy
TRUST_PROXY_HOPS=1
# With SMTP set, self-signups must confirm their e-mail before an admin can approve them
# SMTP_URL=smtps://user:password@smtp.example.org:465
# MAIL_FROM=Mon courrier <no-reply@your-association.fr>
# A volunteer opening more than this many different people's files in one hour raises an alert (alert|suspend)
# AUDIT_READS_PER_HOUR=60
# AUDIT_BULK_READ_ACTION=alert
