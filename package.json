{
  "name": "wilson",
  "private": true,
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck && bun --bun tsc --noEmit -p scripts",
    "test": "bun run --filter '*' test",
    "dev": "bun run --filter '*' dev",
    "local": "bun scripts/local.ts",
    "knowledge:sync": "bun scripts/knowledge-sync.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
