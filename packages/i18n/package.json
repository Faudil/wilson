{
  "name": "@wilson/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ui/*": "./src/ui/*",
    "./web/*": {
      "types": "./src/web/*.ts",
      "default": "./src/web/*.ts"
    },
    "./dates": {
      "types": "./src/dates.ts",
      "default": "./src/dates.ts"
    },
    "./doctypes": {
      "types": "./src/doctypes.ts",
      "default": "./src/doctypes.ts"
    }
  },
  "scripts": {
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@wilson/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
